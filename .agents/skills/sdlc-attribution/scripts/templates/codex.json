{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'r=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -n \"$r\" ] && \"$r/{SKILL_DIR}/track-ai-touch.sh\" codex; exit 0'"
          }
        ]
      }
    ]
  }
}
